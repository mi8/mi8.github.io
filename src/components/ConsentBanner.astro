---
import type { Lang } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<div id="consent-banner" class="consent-banner" hidden role="dialog" aria-live="polite" aria-label="Cookie consent">
  <p class="consent-text">
    {t(lang, 'consent.message')}{' '}
    <a href={localePath(lang, '/privacy')}>{t(lang, 'consent.privacy')}</a>
  </p>
  <div class="consent-actions">
    <button type="button" id="consent-decline" class="consent-btn consent-btn-ghost">{t(lang, 'consent.decline')}</button>
    <button type="button" id="consent-accept" class="consent-btn consent-btn-primary">{t(lang, 'consent.accept')}</button>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 1000;
    max-width: 520px;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem 1.25rem;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius);
    box-shadow: var(--card-shadow-hover);
  }

  /* Higher specificity than the bare class so the attribute keeps it hidden */
  .consent-banner[hidden] {
    display: none;
  }

  .consent-text {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .consent-text a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: flex-end;
  }

  .consent-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.5rem 1.15rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--border-color);
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .consent-btn-ghost {
    background: transparent;
    color: var(--text-secondary);
  }

  .consent-btn-ghost:hover {
    color: var(--text-primary);
    border-color: var(--text-tertiary);
  }

  .consent-btn-primary {
    background: var(--accent);
    color: #001014;
    border-color: var(--accent);
    font-weight: 600;
  }

  .consent-btn-primary:hover {
    box-shadow: 0 0 16px rgba(var(--accent-rgb), 0.5);
  }

  @media (max-width: 520px) {
    .consent-banner {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'mi8-consent';
    var banner = document.getElementById('consent-banner');
    if (!banner) return;

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}

    // Only prompt when no explicit choice has been recorded yet.
    if (stored !== 'granted' && stored !== 'denied') {
      banner.hidden = false;
    }

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }

    function record(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
      if (value === 'granted') {
        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
      }
      banner.hidden = true;
    }

    var accept = document.getElementById('consent-accept');
    var decline = document.getElementById('consent-decline');
    if (accept) accept.addEventListener('click', function () { record('granted'); });
    if (decline) decline.addEventListener('click', function () { record('denied'); });
  })();
</script>
